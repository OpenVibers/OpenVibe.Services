# ═══════════════════════════════════════════════════════════════
# openvibe.services — Environment Configuration
# Copy to .env for development. In production this lives at /etc/openvibe/services.env (0600).
# Names only here; never commit a value.
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4930
HOST=127.0.0.1
NODE_ENV=development
BASE_URL=http://localhost:4930
TRUST_PROXY=1

# ── Data: PostgreSQL (ADR-035) ──────────────────────────────
# Host's roles/add-service.sh writes both in production. Unset in development: an embedded PGlite
# database in data/pglite (one process). Tests need neither.
DATABASE_URL=
DATABASE_DIRECT_URL=

# ── Identity: OpenVibe.Network ──────────────────────────────
OV_NETWORK_URL=https://openvibe.network
# The origin Services asks about project membership (GET /api/v1/projects/:project, with the caller's
# own user token) and reads the signing key from (GET /api/.well-known/jwks).
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
#OV_NETWORK_ISSUER=https://openvibe.network
# Optional: pin the Network's RS256 public key (PEM, \n escaped) instead of fetching the JWKS.
#OV_NETWORK_PUBLIC_KEY=
# Audience Services answers for: incoming service tokens must carry it.
SERVICES_AUDIENCE=openvibe.services
# Services' own Network client: it mints one client-credentials token per authority audience
# (openvibe.network, openvibe.media, …), scoped to that authority's resource.read capability. Unset in
# development: the fan-out calls the authorities without a token and every authority that requires one
# is reported partial — the index degrades, it never stops (ADR-046 section 6).
OV_OAUTH_CLIENT_ID=services
OV_OAUTH_CLIENT_SECRET=

# ── The authorities (plan T13 step 6) ───────────────────────
# An authority is a service whose pinned openvibe-contracts manifest lists <id>.resource.read as
# active; its loopback origin comes from that manifest. SERVICES_<ID>_URL overrides one for the
# operator (the id uppercased, '-' -> '_'):
#SERVICES_NETWORK_URL=http://127.0.0.1:4000
#SERVICES_MEDIA_URL=http://127.0.0.1:4100
#SERVICES_EVENTS_URL=http://127.0.0.1:4300
#SERVICES_CODES_URL=http://127.0.0.1:4900
#SERVICES_HOST_URL=http://127.0.0.1:4910

# ── The resource index ──────────────────────────────────────
# The per-authority page size the fan-out asks for, how many authorities are read at once, and how long
# one authority may take before its rows are omitted and it is named in X-OpenVibe-Partial-Authorities.
SERVICES_INDEX_PAGE_SIZE=100
SERVICES_INDEX_CONCURRENCY=4
SERVICES_INDEX_TIMEOUT_MS=5000
# The caller-facing page size: default and ceiling.
SERVICES_INDEX_DEFAULT_LIMIT=100
SERVICES_INDEX_MAX_LIMIT=1000
# How long the membership question to Network may take before the person-facing path answers 503.
SERVICES_NETWORK_TIMEOUT_MS=5000

# ── OpenVibe.Events ─────────────────────────────────────────
# Services declares no event type yet (plan T13 step 10), so the relay is idle. Set EVENTS_URL and the
# OAuth secret and it publishes the first registered services.* event the moment EVENT_TYPES has one.
EVENTS_URL=
#SERVICES_EVENTS_ENABLED=1
#EVENTS_RELAY_INTERVAL_MS=2000
